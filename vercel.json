{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/archives/application_development/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/application-development/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/english_vocabulary/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/english-vocabulary/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/how_do_i/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/how-do-i/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/internet_adoption_across_the_globe/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/internet-adoption-across-the-globe/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/it_and_business_trends/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/it-and-business-trends/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/other_stuff/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/other-stuff/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/our_world/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/our-world/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/services_and_software/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/services-and-software/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/united_or_not_state_of_american_politics_2004/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/united-or-not-state-of-american-politics-2004/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/us_presidential_elections_2008/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/us-presidential-elections-2008/:post.html",
      "permanent": true
    },
    {
      "source": "/archives/:category([a-z0-9-]+)/:post(\\d{1,}).php",
      "destination": "https://blog.indrayam.com/archives/:category/:post.html",
      "permanent": true
    },
    {
      "source": "/((?!assets/|robots\\.txt$|sitemap\\.xml$|favicon\\.ico$|apple-touch-icon\\.png$).+)",
      "destination": "https://blog.indrayam.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self'; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
